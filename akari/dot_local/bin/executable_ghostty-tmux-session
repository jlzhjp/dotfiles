#!/bin/sh
set -eu

session="$({ tmux list-sessions -F '#{session_name} #{session_attached}' 2>/dev/null || true; } \
  | awk '$1 ~ /^ghostty-[0-9]+$/ && $2 == 0 { sub(/^ghostty-/, "", $1); print $1 }' \
  | sort -n \
  | head -n1)"

if [ -z "$session" ]; then
  session="$({ tmux list-sessions -F '#{session_name}' 2>/dev/null || true; } \
    | awk 'BEGIN { max = -1 } /^ghostty-[0-9]+$/ { sub(/^ghostty-/, ""); if ($0 > max) max = $0 } END { print max + 1 }')"
fi

exec tmux new-session -A -s "ghostty-$session"
